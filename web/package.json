  "scripts": {
    "dev": "vp dev --mode dev",
    "build": "vp build",
    "buildzip": "vp build && ./package.sh",
    "bzip": "vp build && ./package.sh local",
    "preview": "vp preview",
    "build2": "vue-tsc --noEmit && vp build",
    "lint": "vp lint",
    "lint:eslint-fix": "vp lint --fix",
    "lint:prettier-fix": "vp fmt --loglevel warn \"src/**/*.{js,ts,json,tsx,css,less,scss,vue,html,md}\"",
    "lint:stylelint": "stylelint --cache --fix \"**/*.{vue,less,postcss,css,scss}\" --cache --cache-location node_modules/.cache/stylelint/",
    "lint:lint-staged": "lint-staged",
    "commit": "git-cz && git push",
    "commitall": "git pull && git add -A && git-cz && git push"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.20.0",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.23",
    "element-plus": "2.14.7",
    "element-plus-table-dragable": "^1.0.0",
    "naive-ui": "^2.45.3",
    "mitt": "^3.0.1",
    "nprogress": "^0.2.0",
    "pinia": "^4.0.3",
    "qs": "^6.16.0",
    "remixicon": "^4.9.1",
    "screenfull": "^6.0.2",
    "sortablejs": "^1.15.7",
    "validator": "^13.15.35",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/compiler-sfc": "^3.5.43",
    "code-inspector-plugin": "^2.0.9",
    "consola": "^3.4.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-define-config": "^2.1.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.11.1",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.29",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.9",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass": "^1.105.1",
    "stylelint": "^17.16.0",
    "stylelint-config-html": "^2.0.0",
